{
  "name": "kashmiry/sportmonks-football-php",
  "description": "Actively maintained PHP client for the Sportmonks Football API.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Carsten Tetzlaff",
      "role": "Original developer"
    },
    {
      "name": "Kashmiry",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.3",
    "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.8",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "Sportmonks\\Football\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sportmonks\\Test\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group network",
    "analyse": "phpstan analyse",
    "lint": [
      "php-cs-fixer check",
      "rector process --dry-run"
    ],
    "fix": [
      "rector process",
      "php-cs-fixer fix"
    ]
  },
  "keywords": [
    "sportmonks",
    "football",
    "soccer",
    "api-client",
    "php"
  ],
  "support": {
    "issues": "https://github.com/kashmiry/sportmonks-football-php/issues",
    "source": "https://github.com/kashmiry/sportmonks-football-php"
  },
  "conflict": {
    "tetzilla/sportmonks-football-api": "*"
  }
}
